<?xml version="1.0"?>
<robot name="ar4_matlab">

  <!-- ================= Base ================= -->
  <link name="world"/>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-4.6941E-06 0.054174 0.038824" rpy="0 0 0"/>
      <mass value="0.7102"/>
      <inertia
        ixx="0.0039943" ixy="3.697E-07" ixz="-5.7364E-08"
        iyy="0.0014946" iyz="-0.00036051"
        izz="0.0042554"/>
    </inertial>
  </link>

  <!-- ================= Link 1 ================= -->
  <link name="link_1">
    <inertial>
      <origin xyz="-0.022706 0.04294 -0.12205" rpy="0 0 0"/>
      <mass value="0.88065"/>
      <inertia
        ixx="0.0034" ixy="0.00042296" ixz="-0.00089231"
        iyy="0.0041778" iyz="0.0010848"
        izz="0.0027077"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0" rpy="3.141592653589793 0 0"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9670597283903604" upper="2.9670597283903604"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= Link 2 ================= -->
  <link name="link_2">
    <inertial>
      <origin xyz="0.064818 -0.11189 -0.038671" rpy="0 0 0"/>
      <mass value="0.57738"/>
      <inertia
        ixx="0.0047312" ixy="0.0022624" ixz="0.00032144"
        iyy="0.0020836" iyz="-0.00056569"
        izz="0.0056129"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <origin xyz="0 0.0642 -0.16977" rpy="1.5708 0 -1.5708"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.7330382858376184" upper="1.5707963267948966"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= Link 3 ================= -->
  <link name="link_3">
    <inertial>
      <origin xyz="-0.00029765 -0.023661 -0.0019125" rpy="0 0 0"/>
      <mass value="0.1787"/>
      <inertia
        ixx="0.0001685" ixy="-2.7713E-05" ixz="5.6885E-06"
        iyy="0.00012865" iyz="2.9256E-05"
        izz="0.00020744"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <origin xyz="0 -0.305 0.007" rpy="0 0 3.1416"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5533430342749532" upper="0.9075712110370514"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= Link 4 ================= -->
  <link name="link_4">
    <inertial>
      <origin xyz="-0.0016798 -0.00057319 -0.074404" rpy="0 0 0"/>
      <mass value="0.34936"/>
      <inertia
        ixx="0.0030532" ixy="-1.8615E-05" ixz="-7.0047E-05"
        iyy="0.0031033" iyz="-2.3301E-05"
        izz="0.00022264"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <origin xyz="0 0 0" rpy="1.5708 0 -1.5708"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= Link 5 ================= -->
  <link name="link_5">
    <inertial>
      <origin xyz="0.0015066 -1.3102E-05 -0.012585" rpy="0 0 0"/>
      <mass value="0.11562"/>
      <inertia
        ixx="5.5035E-05" ixy="-1.019E-08" ixz="-2.6243E-06"
        iyy="8.2921E-05" iyz="1.4437E-08"
        izz="5.2518E-05"/>
    </inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 -0.22263" rpy="3.141592653589793 0 -1.5708"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.8325957145940461" upper="1.8325957145940461"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= Link 6 ================= -->
  <link name="link_6">
    <inertial>
      <origin xyz="0 0 0.0091432" rpy="0 0 0"/>
      <mass value="0.013863"/>
      <inertia
        ixx="1.3596E-06" ixy="3.0585E-13" ixz="5.7102E-14"
        iyy="1.7157E-06" iyz="6.3369E-09"
        izz="2.4332E-06"/>
    </inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <origin xyz="0 0 0.041" rpy="0 0 3.1416"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141592653589793" upper="3.141592653589793"
           effort="1000" velocity="1.0472"/>
  </joint>

  <!-- ================= End Effector ================= -->
  <link name="ee_link"/>

  <joint name="ee_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link_6"/>
    <child link="ee_link"/>
  </joint>

</robot>

